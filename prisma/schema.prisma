// Deepglot – Prisma Schema
// Database: Neon (serverless PostgreSQL)

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth v5 Required Models ──────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // for credentials provider
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  authenticators Authenticator[]
  memberships   OrganizationMember[]
  projectMemberships ProjectMember[]
  sentProjectInvitations ProjectInvitation[]
  activityDigestDeliveries ActivityDigestDelivery[]
  notificationPreferences NotificationPreference[]
  notificationDeliveries NotificationDelivery[]
  autoUpgradeNotifications AutoUpgradeNotification[]
  translationContentRevisions TranslationContentRevision[]
  professionalOrders ProfessionalTranslationOrder[] @relation("ProfessionalOrderRequester")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String   @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
  @@index([userId])
}

// ─── Organizations (SaaS Mandanten) ───────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      OrganizationMember[]
  projects     Project[]
  subscription Subscription?
  usageRecords UsageRecord[]
  translationBatchLogs TranslationBatchLog[]
  usageAlerts  UsageAlert[]
  activityDigestDeliveries ActivityDigestDelivery[]
  notificationPreferences NotificationPreference[]
  notificationDeliveries NotificationDelivery[]
  autoUpgradePreference AutoUpgradePreference?
  autoUpgradeAttempts AutoUpgradeAttempt[]
  autoUpgradeNotifications AutoUpgradeNotification[]
  aiBudgets AiBudget[]
  aiSpendReservations AiSpendReservation[]
}

/// Dedup marker for the monthly word-quota warning emails to the org owner.
/// One row per (organization, month, threshold) means each threshold (e.g.
/// 90% and 100%) alerts at most once per billing month; the unique constraint
/// also blocks concurrent translate requests from double-sending.
model UsageAlert {
  id             String   @id @default(cuid())
  organizationId String
  month          Int      // YYYYMM, e.g. 202606 — matches UsageRecord.month
  threshold      Int      // percent of the effective limit, e.g. 90 or 100
  sentAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, month, threshold])
  @@index([organizationId, month])
}

enum Plan {
  FREE
  STARTER
  BUSINESS
  PRO
  ADVANCED
  EXTENDED
  ENTERPRISE
  /// @deprecated Renamed to PRO. Kept on the enum for historical rows; new
  /// subscriptions never write this value because the webhook plan map only
  /// emits keys from BILLING_PLANS in src/lib/billing-plans.ts.
  PROFESSIONAL
}

model OrganizationMember {
  id                    String           @id @default(cuid())
  role                  OrganizationRole @default(MEMBER)
  activityDigestEnabled Boolean          @default(false)
  activityDigestLocale  String           @default("en")
  createdAt             DateTime         @default(now())

  userId         String
  organizationId String

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notificationPreferences NotificationPreference[]
  notificationDeliveries NotificationDelivery[]

  @@unique([userId, organizationId])
}

/// Optional email preferences belong to a user within one workspace.
/// Mandatory account and security mail is deliberately absent from this enum.
enum NotificationCategory {
  PRODUCT_UPDATE
  PROJECT_ACTIVITY
  BILLING_SUMMARY
}

enum NotificationFrequency {
  OFF
  WEEKLY
  MONTHLY
}

model NotificationPreference {
  id             String @id @default(cuid())
  userId         String
  organizationId String
  category       NotificationCategory
  frequency      NotificationFrequency @default(OFF)
  locale         String @default("en")
  updatedAt      DateTime @updatedAt

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership OrganizationMember @relation(fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@unique([userId, organizationId, category])
  @@index([organizationId, category, frequency])
}

/// One claim for each optional email, recipient and scheduled period.
model NotificationDelivery {
  id             String @id @default(cuid())
  userId         String
  organizationId String
  category       NotificationCategory
  periodStart    DateTime
  claimedAt      DateTime @default(now())
  sentAt         DateTime?

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership OrganizationMember @relation(fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@unique([userId, organizationId, category, periodStart])
  @@index([periodStart])
}

/// Per-recipient claim for a complete weekly activity period. The unique key
/// prevents duplicate emails when Vercel retries or two cron invocations race.
model ActivityDigestDelivery {
  id          String    @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  claimedAt   DateTime  @default(now())
  sentAt      DateTime?

  organizationId  String
  recipientUserId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient    User         @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([organizationId, recipientUserId, periodStart])
  @@index([periodStart])
  @@index([recipientUserId])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

// ─── Projects (Websites / WordPress Instanzen) ────────────────────────────

model Project {
  id             String    @id @default(cuid())
  name           String
  domain         String    // e.g. "example.com"
  originalLang   String    @default("de") // ISO 639-1
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  languages      ProjectLanguage[]
  translations   Translation[]
  apiKeys        ApiKey[]
  usageRecords   UsageRecord[]
  glossaryRules  GlossaryRule[]
  urlSlugs       UrlSlug[]
  mediaReplacements ProjectMediaReplacement[]
  exclusions     TranslationExclusion[]
  translatedUrls TranslatedUrl[]
  urlCacheInvalidations UrlCacheInvalidation[]
  urlOperationReceipts UrlOperationReceipt[]
  pageViews      PageView[]
  settings       ProjectSettings?
  sourcePageSnapshots SourcePageSnapshot[]
  members        ProjectMember[]
  invitations    ProjectInvitation[]
  domainMappings ProjectDomainMapping[]
  translationBatchLogs TranslationBatchLog[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  aiBudget AiBudget?
  professionalOrders ProfessionalTranslationOrder[]
}

/// Approval is explicit. A missing row is a deny, including for legacy tenants.
/// An organization row has projectId NULL; a project row has its projectId.
/// The partial unique index permits one organization-wide policy beside its project policies.
model AiBudget {
  id String @id @default(cuid())
  organizationId String
  projectId String? @unique
  currency String @db.VarChar(3)
  capMicros BigInt
  perCallCapMicros BigInt
  warningPercent Int
  period String // MONTHLY_UTC; no rollover
  approvedByUserId String
  approvedAt DateTime @default(now())
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  models AiBudgetModel[]

  @@index([organizationId])
  @@unique([organizationId], map: "AiBudget_one_org_policy_idx", where: { projectId: null })
}

/// Owner-approved conservative price ceilings, never live or inferred prices.
/// micros are 1/1,000,000 of the configured currency per 1,000,000 units.
model AiBudgetModel {
  id String @id @default(cuid())
  budgetId String
  provider String
  model String
  unit String // TOKEN, CHARACTER or ZERO_COST
  inputMicrosPerMillion BigInt
  outputMicrosPerMillion BigInt
  maxInputUnits Int
  maxOutputUnits Int
  outputCapVerified Boolean @default(false)
  priceExpiresAt DateTime
  approvedAt DateTime @default(now())
  budget AiBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, provider, model])
}

/// Dispatch is durable before HTTP. Incomplete/unknown usage keeps its full
/// reserved ceiling; no stale lease or retry may re-dispatch the same key.
model AiSpendReservation {
  id String @id @default(cuid())
  organizationId String
  // Immutable originating project ID. Intentionally no live Project FK:
  // settled ledger history must survive an allowed project deletion.
  projectId String
  requestKeyHash String
  requestGroupHash String
  dispatchId String
  actorKind String // USER or API_KEY
  actorId String
  action String
  provider String
  model String
  currency String @db.VarChar(3)
  periodKey Int // YYYYMM in UTC
  state String // DISPATCHED, SETTLED, UNKNOWN
  reservedMicros BigInt
  reconciledCeilingMicros BigInt?
  estimatedInputUnits Int
  maxOutputUnits Int
  orgInputMicrosPerMillion BigInt
  orgOutputMicrosPerMillion BigInt
  projectInputMicrosPerMillion BigInt
  projectOutputMicrosPerMillion BigInt
  actualInputUnits Int?
  actualOutputUnits Int?
  resolutionKind String?
  resolutionEvidenceHash String?
  resolvedByUserId String?
  resolvedAt DateTime?
  unit String
  dispatchedAt DateTime @default(now())
  settledAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, requestKeyHash])
  @@index([organizationId, periodKey])
  @@index([projectId, periodKey])
  @@index([organizationId, requestGroupHash])
}

/// Durable, tenant-scoped approval and alert markers. Contains no content.
model AiBudgetEvent {
  id String @id @default(cuid())
  organizationId String
  projectId String?
  budgetId String
  kind String
  periodKey Int?
  threshold Int?
  actorId String?
  revision Int?
  snapshot Json?
  createdAt DateTime @default(now())

  @@unique([budgetId, kind, periodKey, threshold])
  @@index([organizationId, createdAt])
}

/// Immutable receipt for a committed workspace boundary change. No key, URL,
/// translated content, or webhook payload is stored in this audit row.
model ProjectTransferAudit {
  id String @id @default(cuid())
  projectId String
  actorUserId String
  sourceOrganizationId String
  destinationOrganizationId String
  previewFingerprint String @unique
  projectVersion DateTime
  outcome String @default("COMMITTED")
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([sourceOrganizationId, createdAt])
  @@index([destinationOrganizationId, createdAt])
}

/// Factual workspace administration receipt. Kept without foreign keys so
/// account lifecycle operations do not rewrite or erase historical actions.
model WorkspaceAudit {
  id String @id @default(cuid())
  workspaceId String
  actorUserId String
  action String
  targetUserId String?
  previousRole OrganizationRole?
  nextRole OrganizationRole?
  previousName String?
  nextName String?
  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
}

/// A durable authorization decision made before an external billing request.
/// The org row lock serializes this decision with workspace role changes.
/// No Stripe result or sensitive address data is inferred from this receipt.
model BillingCommand {
  id String @id @default(cuid())
  workspaceId String
  actorUserId String
  actorRole OrganizationRole
  action String
  targetRef String?
  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
}

model ProjectLanguage {
  id        String   @id @default(cuid())
  langCode  String   // normalized lowercase BCP 47 language/script/region tag
  isActive  Boolean  @default(true)
  isVisible Boolean  @default(true)
  automaticTranslation Boolean @default(true)
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, langCode])
}

// ─── Translations (Übersetzungs-Cache) ────────────────────────────────────

model Translation {
  id             String                    @id @default(cuid())
  originalHash   String                    // md5 of (originalText + langFrom + langTo)
  originalText   String
  translatedText String
  langFrom       String                    // ISO 639-1
  langTo         String                    // ISO 639-1
  source         TranslationSource         @default(DEEPL)
  isManual       Boolean                   @default(false) // manually edited
  wordCount      Int                       @default(0)
  workflowStatus TranslationWorkflowStatus @default(MACHINE)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  projectId   String
  assignedToId String?
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo  ProjectMember? @relation("TranslationAssignment", fields: [assignedToId], references: [id], onDelete: SetNull)
  contexts    TranslationContext[]
  metadata    TranslationMetadata?
  typeObservations TranslationTypeObservation[]
  contentRevisions TranslationContentRevision[]

  @@unique([projectId, originalHash])
  @@index([projectId, langFrom, langTo])
  @@index([projectId, langTo, workflowStatus])
  @@index([assignedToId])
}

// Paid professional work is separate from the authoritative translation cache.
// Snapshot rows are append-only in the application; changing source text later
// cannot silently change what a vendor was asked to translate.
model ProfessionalTranslationOrder {
  id String @id @default(cuid())
  projectId String // immutable origin; remains after live project deletion
  activeProjectId String? // live capability only; detached when history is archived
  projectDetachedAt DateTime?
  organizationId String? // immutable billing owner snapshot; legacy null rows fail closed
  requesterId String
  status ProfessionalTranslationOrderStatus @default(QUOTE_REQUESTED)
  sourceLanguage String
  targetLanguage String
  scopeDigest String
  wordCount Int
  quoteAmountMinor Int?
  quoteCurrency String?
  quoteTurnaroundDays Int?
  quoteExpiresAt DateTime?
  quoteReference String?
  quoteTermsVersion String?
  selectedVendorGrantId String?
  checkoutRequestKey String? @unique
  checkoutAttemptedAt DateTime?
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId String? @unique
  paymentReference String? @unique
  paymentProvider String?
  paidAt DateTime?
  canceledAt DateTime?
  refundReference String?
  failureCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project? @relation(fields: [activeProjectId], references: [id], onDelete: SetNull)
  requester User @relation("ProfessionalOrderRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  items ProfessionalTranslationOrderItem[]
  events ProfessionalTranslationOrderEvent[]
  vendorGrants ProfessionalTranslationVendorGrant[]

  @@index([projectId, createdAt])
  @@index([activeProjectId, status])
  @@index([status, quoteExpiresAt])
}

enum ProfessionalTranslationOrderStatus {
  QUOTE_REQUESTED
  QUOTED
  EXPIRED
  PAYMENT_PENDING
  PAID
  IN_PROGRESS
  DELIVERED
  CANCELED
  REFUND_PENDING
  REFUNDED
  DISPUTED
  FAILED
}

model ProfessionalTranslationOrderItem {
  id String @id @default(cuid())
  orderId String
  translationId String
  originalHash String
  originalText String
  sourceUpdatedAt DateTime
  proposedText String?
  deliveredAt DateTime?
  adoptedAt DateTime?
  adoptedById String?
  order ProfessionalTranslationOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, translationId])
  @@index([translationId])
}

model ProfessionalTranslationOrderEvent {
  id String @id @default(cuid())
  orderId String
  kind String
  actorType String
  actorId String?
  reference String?
  createdAt DateTime @default(now())
  order ProfessionalTranslationOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, kind, reference])
  @@index([orderId, createdAt])
}

// A scoped, expiring capability. Only a hash is stored; a grant belongs to one
// order and exposes neither project membership nor platform API credentials.
model ProfessionalTranslationVendorGrant {
  id String @id @default(cuid())
  orderId String
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  order ProfessionalTranslationOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// New direct workspace edits only; not a complete translation audit trail.
model TranslationContentRevision {
  id String @id @default(cuid())
  translationId String
  actorUserId String?
  beforeText String
  afterText String
  createdAt DateTime @default(now())
  translation Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([translationId, createdAt, id])
  @@index([actorUserId])
}

// Client-reported provenance, not inferred content classification.
model TranslationTypeObservation {
  translationId String
  wordType Int
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  translation Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@id([translationId, wordType])
}

// Editorial annotations; independent of translation content concurrency tokens.
model TranslationMetadata {
  translationId String @id
  labels String[] @default([])
  variables String[] @default([])
  note String @default("")
  version Int @default(1)
  updatedAt DateTime @updatedAt
  translation Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@index([labels], type: Gin)
}

// Observed segment/page associations. Never store URL queries or fragments.
model TranslationContext {
  translationId String
  urlPath       String
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  translation   Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@id([translationId, urlPath])
  @@index([urlPath])
}

// Latest bounded server-rendered source observation for one translated page.
// Absence is meaningful only while complete, fresh and free of dynamic content.
model SourcePageSnapshot {
  id String @id @default(cuid())
  projectId String
  urlPath String
  langFrom String
  langTo String
  originalHashes String[] @default([])
  complete Boolean
  dynamicPossible Boolean
  provenance String
  contentDigest String
  clientCapturedMicros BigInt
  uncertainUntil DateTime?
  capturedAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, urlPath, langTo])
  @@index([projectId, langTo, capturedAt])
}

enum TranslationSource {
  DEEPL
  OPENAI
  GOOGLE
  MANUAL
  MOCK
  IMPORT
}

enum TranslationWorkflowStatus {
  MACHINE
  ASSIGNED
  IN_REVIEW
  APPROVED
}

// ─── API Keys (Plugin-Authentifizierung) ──────────────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  key         String    @unique // hashed
  keyPrefix   String    // first 8 chars for display, e.g. "dg_live_"
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── Stripe Subscriptions ─────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  stripeCurrentPeriodEnd DateTime?
  status               SubscriptionStatus @default(INACTIVE)
  plan                 Plan               @default(FREE)
  wordsLimit           Int                @default(10000) // words per month
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Off until an owner explicitly accepts a paid tier and recurring price ceiling.
model AutoUpgradePreference {
  id String @id @default(cuid())
  organizationId String @unique
  enabled Boolean @default(false)
  maxPlan Plan @default(STARTER)
  maxPriceCents Int @default(0)
  interval String @default("monthly")
  updatedByUserId String?
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// One attempt per starting tier and UTC usage month. Unknown Stripe outcomes are held for reconciliation.
model AutoUpgradeAttempt {
  id String @id @default(cuid())
  organizationId String
  month Int
  fromPlan Plan
  toPlan Plan
  fromPriceId String
  toPriceId String
  interval String
  maxPriceCents Int
  usedWords Int
  status String @default("CLAIMED")
  stripeSubscriptionId String
  stripeItemId String?
  stripeInvoiceId String?
  billingCommandId String? @unique
  errorCode String?
  claimedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notifications AutoUpgradeNotification[]
  @@unique([organizationId, month, fromPlan])
  @@index([stripeSubscriptionId, status])
}

/// Durable in-app owner notice; email delivery can be added without losing the event.
model AutoUpgradeNotification {
  id String @id @default(cuid())
  attemptId String
  userId String
  organizationId String
  kind String
  createdAt DateTime @default(now())
  readAt DateTime?
  attempt AutoUpgradeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([attemptId, userId, kind])
  @@index([userId, createdAt])
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

// ─── Project Settings ─────────────────────────────────────────────────────

model ProjectSettings {
  id                      String   @id @default(cuid())

  // General
  autoSwitch              Boolean  @default(false)
  displayAiNotice         Boolean  @default(false)
  automaticTranslation    Boolean  @default(true)
  translationMemory       Boolean  @default(false)
  websiteType             String?  // Blog, Corporate, E-Commerce, etc.
  industryType            String?  // Health & medical, etc.
  websiteDescription      String?
  translationTone         String?
  translationAudience     String?
  translationInstructions String?
  useGlossaryAsContext    Boolean  @default(false)
  useApprovedTranslationsAsContext Boolean @default(false)
  translationProvider     String?  // openai, openrouter, ollama, openai-compatible, deepl, mock
  translationModel        String?
  translationBaseUrl      String?
  translationApiKeyEncrypted String?
  providerReconnectRequired Boolean @default(false)
  translationApiKeyUpdatedAt DateTime?
  routingMode             RoutingMode @default(PATH_PREFIX)
  runtimeSyncedAt         DateTime?
  // Host reported by the last plugin sync plus the mirrored fields that
  // differed from the SaaS values. Surfaces API-key reuse by a foreign site.
  runtimeSyncSiteHost     String?
  runtimeSyncApiKeyId     String?  // ApiKey.id that sent the last sync; cleared with the key
  runtimeSyncConflicts    String[] @default([])

  // Language Switcher
  switcherDisplayName     Boolean  @default(true)
  switcherFullName        Boolean  @default(true)
  switcherFlags           Boolean  @default(true)
  switcherDropdown        Boolean  @default(true)
  switcherFlagsType       String   @default("rectangle_mat")
  switcherCustomCss       String?
  // Versioned switcher contract. WordPress remains the owner until a manager
  // explicitly adopts its last reported configuration in the dashboard.
  switcherOwner           String   @default("wordpress")
  switcherRevision        Int      @default(0)
  switcherConfig          Json?
  switcherBaseConfig      Json?
  switcherBaseRevision    Int?
  switcherPluginConfig    Json?
  switcherPluginRevision  Int?
  switcherPluginSyncedAt  DateTime?
  switcherConflict        Boolean  @default(false)

  // WordPress-specific
  translateEmails         Boolean  @default(false)
  translateSearch         Boolean  @default(false)
  translateAmp            Boolean  @default(false)

  // Page views tracking
  pageViewsEnabled        Boolean  @default(false)
  // Set only after explicit consent to real, privacy-minimized collection.
  // Legacy pageViewsEnabled flags without this timestamp remain disabled.
  pageViewsConsentGrantedAt DateTime?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  projectId String @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum RoutingMode {
  PATH_PREFIX
  SUBDOMAIN
}

// ─── Project Members ──────────────────────────────────────────────────────

model ProjectMember {
  id        String      @id @default(cuid())
  email     String
  role      ProjectRole @default(TRANSLATOR)
  langCode  String?     // language they are responsible for
  createdAt DateTime    @default(now())

  projectId String
  userId    String?
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedTranslations Translation[] @relation("TranslationAssignment")

  @@unique([projectId, email])
  @@index([userId])
}

enum ProjectRole {
  ADMIN
  TRANSLATOR
}

model ProjectInvitation {
  id         String      @id @default(cuid())
  email      String
  role       ProjectRole @default(TRANSLATOR)
  langCode   String?
  tokenHash  String      @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime    @default(now())

  projectId String
  inviterId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter User    @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([projectId, email])
  @@index([expiresAt])
}

// ─── Glossary Rules ───────────────────────────────────────────────────────

model GlossaryRule {
  id             String   @id @default(cuid())
  originalTerm   String
  translatedTerm String
  langFrom       String   // ISO 639-1
  langTo         String   // ISO 639-1
  caseSensitive  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, originalTerm, langFrom, langTo])
  @@index([projectId, langFrom, langTo])
}

model ProjectDomainMapping {
  id        String   @id @default(cuid())
  host      String   @unique
  langCode  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, langCode])
  @@index([projectId])
}

// ─── URL Slugs (übersetzbare URL-Pfadsegmente) ───────────────────────────

model UrlSlug {
  id             String   @id @default(cuid())
  originalSlug   String
  translatedSlug String?
  langTo         String   // ISO 639-1
  urlCount       Int      @default(0) // how many URLs use this slug
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, originalSlug, langTo])
  @@index([projectId, langTo])
}

// ─── Locale-specific image replacements ───────────────────────────────────

model ProjectMediaReplacement {
  id           String   @id @default(cuid())
  originalUrl  String
  localizedUrl String
  langTo       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, langTo, originalUrl])
  @@index([projectId, langTo])
}

// ─── Translation Exclusions ───────────────────────────────────────────────

model TranslationExclusion {
  id        String          @id @default(cuid())
  type      ExclusionType
  value     String          // URL pattern, CSS selector, or regex
  createdAt DateTime        @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type, value])
  @@index([projectId, type])
}

enum ExclusionType {
  URL         // full URL or wildcard
  CSS_CLASS   // CSS class selector
  CSS_ID      // CSS ID selector
  REGEX       // regex pattern
}

// ─── Translated URLs (Statistiken pro URL) ────────────────────────────────

model TranslatedUrl {
  id          String   @id @default(cuid())
  urlPath     String   // e.g. "/hautkrebsvorsorge-muttermalkontrolle-wien"
  langTo      String   // ISO 639-1
  wordCount   Int      @default(0)
  requestCount Int     @default(0) // how often this URL was translated
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  // Nullable: older request analytics cannot prove a crawl result or HTTP code.
  operationState String?
  lastResult String?
  lastHttpStatus Int?
  origin String?
  lastOperationAt DateTime?
  lastError String?
  operationToken String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, urlPath, langTo])
  @@index([projectId, langTo])
  @@index([projectId, requestCount(sort: Desc)])
}

// Durable, digest-only invalidation feed for WordPress translation transients.
model UrlCacheInvalidation {
  id        BigInt   @id @default(autoincrement())
  projectId String
  urlPath   String
  cacheKey  String   // SHA-1 of source language, target language and original text
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, id])
}

// A persistence receipt is committed with billed usage after provider work.
// It resolves a manager response/status crash without sending the provider twice.
model UrlOperationReceipt {
  id String @id // SHA-256 confirmation token
  projectId String
  originatingOrganizationId String? // new writers capture billed workspace; legacy null blocks transfer
  urlId String
  actorId String
  urlPath String
  langTo String
  billedWords Int
  segmentCount Int
  totalEligibleSegments Int
  remainingSegments Int
  nextAfterId String?
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, urlId])
  @@index([originatingOrganizationId, createdAt])
}

// Opt-in visitor events. Query strings, fragments, IP addresses, user agents,
// referrers, cookies and visitor identifiers are deliberately never stored.
// Events are deleted automatically after the documented 90-day retention.
model PageView {
  id        String   @id @default(cuid())
  eventId   String   @unique
  urlPath   String
  langTo    String
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, langTo, createdAt])
  @@index([projectId, urlPath, langTo, createdAt])
  @@index([createdAt])
}

model TranslationBatchLog {
  id              String   @id @default(cuid())
  langFrom        String
  langTo          String
  requestUrl      String?
  provider        String
  totalWords      Int      @default(0)
  cachedWords     Int      @default(0)
  manualWords     Int      @default(0)
  glossaryWords   Int      @default(0)
  translatedWords Int      @default(0)
  createdAt       DateTime @default(now())

  organizationId String
  projectId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([projectId, langFrom, langTo])
}

// ─── Usage Tracking ───────────────────────────────────────────────────────

model UsageRecord {
  id        String   @id @default(cuid())
  words     Int      // words translated
  month     Int      // YYYYMM, e.g. 202603
  createdAt DateTime @default(now())

  organizationId String
  projectId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([organizationId, projectId, month])
  @@index([organizationId, month])
  @@index([projectId, month])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  scope       String
  subjectHash String
  count       Int      @default(0)
  resetAt     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, subjectHash])
  @@index([resetAt])
}

model ApiIdempotencyRecord {
  id              String   @id @default(cuid())
  scope           String
  keyHash         String
  requestHash     String
  status          String
  ownerToken      String?
  responseStatus  Int?
  responseHeaders Json?
  responseBody    String?
  expiresAt       DateTime
  leaseExpiresAt  DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([scope, keyHash])
  @@index([expiresAt])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WebhookProcessorRunStatus {
  SUCCESS
  FAILED
}

model WebhookEndpoint {
  id                 String    @id @default(cuid())
  url                String
  secret             String
  eventTypes         String[]
  enabled            Boolean   @default(true)
  lastDeliveryStatus WebhookDeliveryStatus?
  lastDeliveryAt     DateTime?
  lastDeliveryCode   Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  deliveries WebhookDelivery[]

  @@index([projectId, enabled])
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  eventType      String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attemptCount   Int                   @default(0)
  nextAttemptAt  DateTime              @default(now())
  lastAttemptAt  DateTime?
  responseStatus Int?
  responseBody   String?
  errorMessage   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  endpointId String
  projectId  String

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([endpointId, status, nextAttemptAt])
  @@index([projectId, createdAt])
}

model WebhookProcessorRun {
  id                    String                    @id @default(cuid())
  status                WebhookProcessorRunStatus
  processedCount        Int                       @default(0)
  deliveredCount        Int                       @default(0)
  failedCount           Int                       @default(0)
  pendingRemainingCount Int                       @default(0)
  durationMs            Int                       @default(0)
  errorMessage          String?
  createdAt             DateTime                  @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
}
