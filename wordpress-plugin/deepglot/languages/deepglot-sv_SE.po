#: includes/Admin/SettingsPage.php:1021
#, php-format
msgid "Help & Documentation: %s"
msgstr "Hjälp och dokumentation: %s"

#: includes/Admin/SettingsPage.php:1155
msgid "Not started yet"
msgstr "Inte startad"

#: includes/Admin/SettingsPage.php:1156
msgid "In queue"
msgstr "I kö"

#: includes/Admin/SettingsPage.php:1157
msgid "Running"
msgstr "Pågår"

#: includes/Admin/SettingsPage.php:1158
msgid "Translations are being cached"
msgstr "Översättningarna förbereds"

#: includes/Admin/SettingsPage.php:1159
msgid "Waiting due to API rate limit"
msgstr "Väntar på grund av API:ets hastighetsbegränsning"

#: includes/Admin/SettingsPage.php:1160
msgid "Paused"
msgstr "Pausad"

#: includes/Admin/SettingsPage.php:1161
msgid "Paused: word quota reached"
msgstr "Pausad: ordkvoten har nåtts"

#: includes/Admin/SettingsPage.php:1162
msgid "Paused: API key invalid"
msgstr "Pausad: API-nyckeln är ogiltig"

#: includes/Admin/SettingsPage.php:1163
msgid "Completed"
msgstr "Slutförd"

#: includes/Admin/SettingsPage.php:1164
msgid "Completed with errors"
msgstr "Slutförd med fel"

#: includes/Admin/SettingsPage.php:1165
msgid "Aborted"
msgstr "Avbruten"

#: includes/Admin/SettingsPage.php:1186
msgid "URL synchronization"
msgstr "URL-synkronisering"

#: includes/Admin/SettingsPage.php:1187
msgid "Opens selected target language pages in a controlled manner in the background. Missing segments end up in the limited translation queue; Bots and an unlimited duration crawl are not used."
msgstr "Hämtar valda sidor på målspråken i bakgrunden, med begränsningar. Saknade textsegment läggs i den begränsade översättningskön. Inga robotar eller obegränsade genomsökningar används."

#: includes/Admin/SettingsPage.php:1197
msgid "Status:"
msgstr "Status:"

#: includes/Admin/SettingsPage.php:1206
msgid "URLs total"
msgstr "Totalt antal URL:er"

#: includes/Admin/SettingsPage.php:1207
msgid "Queue processed"
msgstr "Kö behandlad"

#: includes/Admin/SettingsPage.php:1208
msgid "Being cached"
msgstr "Förbereds"

#: includes/Admin/SettingsPage.php:1209
msgid "Failed"
msgstr "Misslyckades"

#: includes/Admin/SettingsPage.php:1211
msgid "\"Processed\" confirms completion in the Deepglot queue at the WordPress origin. Afterward, check the public target-language page without sync parameters and manually clear any unsupported full-page cache."
msgstr "”Kö behandlad” bekräftar att Deepglots kö på WordPress-servern har behandlats. När körningen är klar kontrollerar du den offentliga sidan på målspråket utan synkroniseringsparametrar. Töm manuellt en cache för hela sidor om den inte stöds."

#: includes/Admin/SettingsPage.php:1216
msgid "Failed URLs"
msgstr "URL:er som misslyckades"

#: includes/Admin/SettingsPage.php:1236
msgid "Retry failed URLs"
msgstr "Försök igen med URL:er som misslyckades"

#: includes/Admin/SettingsPage.php:1242
msgid "URL preview"
msgstr "URL-förhandsvisning"

#. translators: %d: number of target-language URLs in the preview.
#: includes/Admin/SettingsPage.php:1247
#, php-format
msgid "%d target pages will be synchronized."
msgstr "%d målsidor synkroniseras."

#: includes/Admin/SettingsPage.php:1267
msgid "Confirm preview and start synchronization"
msgstr "Bekräfta förhandsvisningen och starta synkroniseringen"

#: includes/Admin/SettingsPage.php:1286
msgid "Maximum number of target pages"
msgstr "Maximalt antal målsidor"

#: includes/Admin/SettingsPage.php:1288
msgid "Start with a small sample on large sites. Each run requests at most two pages; synchronization waits when the translation queue is full."
msgstr "Börja med ett litet urval på stora webbplatser. Högst två sidor startas per körning. Om översättningskön är full väntar synkroniseringen automatiskt."

#: includes/Admin/SettingsPage.php:1292
msgid "Load the next URL batch as a preview"
msgstr "Förhandsvisa nästa URL-grupp"

#: includes/Admin/SettingsPage.php:1293
msgid "Create URL preview"
msgstr "Skapa URL-förhandsvisning"

#: includes/Admin/SettingsPage.php:1299
