msgstr "Aktiv – sidor översätts från %1$s till %2$s på /%3$s/your-page/"

#: includes/Admin/SettingsPage.php:595
msgid "Automatically redirect visitors based on browser language (optional)"
msgstr "Omdirigera besökare automatiskt utifrån webbläsarens språk (valfritt)"

