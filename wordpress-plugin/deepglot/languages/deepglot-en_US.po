msgid "Backend-URL"
msgstr "Backend URL"

#: includes/Admin/SettingsPage.php:480
msgid "Standard: https://deepglot.ai/api – nur ändern bei Self-Hosting."
msgstr "Default: https://deepglot.ai/api – only change for Self-Hosting."

