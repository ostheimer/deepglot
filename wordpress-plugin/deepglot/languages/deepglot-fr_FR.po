#. Description of the plugin
#: deepglot.php
msgid "Translates WordPress content with Deepglot and a compatible translation API."
msgstr "Traduit le contenu WordPress à l’aide de Deepglot et d’une API de traduction compatible."

#. Author of the plugin
#: deepglot.php
msgid "Andreas Ostheimer"
msgstr "Andreas Ostheimer"

#. Author URI of the plugin
