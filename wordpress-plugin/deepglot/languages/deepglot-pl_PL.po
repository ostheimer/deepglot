#. Plugin Name of the plugin
#: deepglot.php
#: includes/Admin/SettingsPage.php:217
#: includes/Admin/SettingsPage.php:218
msgid "Deepglot"
msgstr "Deepglot"

#. Plugin URI of the plugin
#: deepglot.php
msgid "https://deepglot.ai"
msgstr "https://deepglot.ai"

#. Description of the plugin
#: deepglot.php
msgid "Translates WordPress content with Deepglot and a compatible translation API."
msgstr "Tłumaczy zawartość WordPress przy użyciu Deepglot i kompatybilnego interfejsu API tłumaczenia."

#. Author of the plugin
#: deepglot.php
msgid "Andreas Ostheimer"
msgstr "Andreasa Ostheimera"

#. Author URI of the plugin
#: deepglot.php
msgid "https://www.ostheimer.at"
msgstr "https://www.ostheimer.at"

#: includes/Admin/NavMenuMetaBox.php:26
#: includes/Frontend/SwitcherBlock.php:61
#: includes/Frontend/SwitcherWidget.php:25
#: assets/js/block-switcher.js:19
msgid "Deepglot language switcher"
msgstr "Deepglot Zmiana języka"

#: includes/Admin/NavMenuMetaBox.php:41
msgid "Adds a language switch entry that automatically expands into one entry per language when viewed."
msgstr "Dodaje wpis dotyczący zmiany języka, który podczas przeglądania automatycznie rozwija się do jednego wpisu na każdy język."

#: includes/Admin/NavMenuMetaBox.php:44
msgid "Display mode"
msgstr "Tryb wyświetlania"

#: includes/Admin/NavMenuMetaBox.php:49
msgid "List (each language as a separate menu item)"
msgstr "Lista (każdy język jako osobna pozycja menu)"

#: includes/Admin/NavMenuMetaBox.php:55
msgid "Dropdown (active language as parent, alternatives as submenu)"
msgstr "Lista rozwijana (aktywny język jako rodzic, alternatywy jako podmenu)"

#: includes/Admin/NavMenuMetaBox.php:61
msgid "Hide active language from the list"
msgstr "Ukryj aktywny język na liście"

#: includes/Admin/NavMenuMetaBox.php:71
msgid "Add to menu"
msgstr "Dodaj do menu"

#: includes/Admin/NavMenuMetaBox.php:98
#: includes/Admin/SettingsPage.php:1341
#: includes/Config/SwitcherTemplates.php:115
msgid "Language switcher"
msgstr "Przełącznik głosowy"

#: includes/Admin/SettingsPage.php:65
msgid "The URL preview is ready. Check the selection and then confirm the start."
msgstr "Podgląd URL jest gotowy. Sprawdź wybór, a następnie potwierdź start."

#: includes/Admin/SettingsPage.php:87
msgid "URL synchronization has started."
msgstr "Rozpoczęła się synchronizacja URL."

#: includes/Admin/SettingsPage.php:103
msgid "Invalid action."
msgstr "Nieprawidłowa akcja."

#: includes/Admin/SettingsPage.php:110
msgid "The status of the URL synchronization has been updated."
msgstr "Stan synchronizacji URL został zaktualizowany."

#: includes/Admin/SettingsPage.php:111
msgid "The URL synchronization could not be changed in its current state."
msgstr "Nie można zmienić synchronizacji URL w jej bieżącym stanie."

#: includes/Admin/SettingsPage.php:118
#: includes/Api/RestApi.php:474
msgid "You need administrator rights for this action."
msgstr "Do tej akcji potrzebne są uprawnienia administratora."

#: includes/Admin/SettingsPage.php:174
msgid "Deepglot: API key invalid or revoked."
msgstr "Deepglot: API-Key nieprawidłowy lub unieważniony."

#: includes/Admin/SettingsPage.php:175
msgid "The Deepglot server rejects any translation request (HTTP 401). Content that has already been cached will continue to be delivered, but nothing new will be translated. Store a valid API key in the Deepglot settings, then it takes effect immediately."
msgstr "Serwer Deepglot odrzuca wszelkie żądania tłumaczenia (HTTP 401). Treści, które zostały już zapisane w pamięci podręcznej, będą nadal dostarczane, ale nic nowego nie będzie tłumaczone. Zapisz prawidłowy API-Key w ustawieniach Deepglot, a następnie zacznie obowiązywać natychmiast."

#: includes/Admin/SettingsPage.php:177
msgid "Check API key in the Deepglot dashboard"
msgstr "Sprawdź API-Key w panelu kontrolnym Deepglot"

#: includes/Admin/SettingsPage.php:204
msgid "Deepglot: Monthly word limit reached."
msgstr "Deepglot: Osiągnięto miesięczny limit słów."

#: includes/Admin/SettingsPage.php:205
msgid "Content that has already been translated will continue to be delivered, but new or changed text will remain in the source language until the quota is reset or increased."
msgstr "Treści, które zostały już przetłumaczone, będą nadal dostarczane, ale nowy lub zmieniony tekst pozostanie w języku źródłowym do czasu zresetowania lub zwiększenia limitu."

#: includes/Admin/SettingsPage.php:207
msgid "Check quota in the Deepglot dashboard"
msgstr "Sprawdź limit w panelu kontrolnym Deepglot"

#: includes/Admin/SettingsPage.php:385
msgid "Invalid API key"
msgstr "API-Key nieprawidłowy"

#: includes/Admin/SettingsPage.php:388
msgid "Active"
msgstr "Aktywny"

#: includes/Admin/SettingsPage.php:391
msgid "Disabled"
msgstr "Niepełnosprawny"

#: includes/Admin/SettingsPage.php:394
msgid "Setup required"
msgstr "Wymagana konfiguracja"

#: includes/Admin/SettingsPage.php:417
msgid "Welcome to Deepglot! Follow the three steps below to enable translation on your website."
msgstr "Witamy w Deepglot! Wykonaj trzy poniższe kroki, aby włączyć tłumaczenie w swojej witrynie."

#: includes/Admin/SettingsPage.php:428
msgid "Set up Deepglot"
msgstr "Skonfiguruj Deepglot"

#: includes/Admin/SettingsPage.php:429
msgid "You only need an API key from the Deepglot dashboard. Setup takes less than two minutes."
msgstr "Wszystko czego potrzebujesz to API-Key z panelu Deepglot - zajmuje to mniej niż dwie minuty."

#: includes/Admin/SettingsPage.php:441
msgid "Enter API key"
msgstr "Wprowadź API-Key"

#: includes/Admin/SettingsPage.php:444
msgid "The stored API key is rejected by the Deepglot server (HTTP 401). No new content is currently being translated - enter a valid key and save."
msgstr "Zapisany API-Key jest odrzucany przez serwer Deepglot (HTTP 401). Żadna nowa treść nie jest obecnie tłumaczona - wprowadź prawidłowy klucz i zapisz."

#: includes/Admin/SettingsPage.php:449
msgid "Create a free account on deepglot.ai, create a project for your website and copy the API key."
msgstr "Utwórz bezpłatne konto na deepglot.ai, utwórz projekt dla swojej witryny i skopiuj plik API-Key."

#: includes/Admin/SettingsPage.php:452
msgid "Go to dashboard – create API key"
msgstr "Przejdź do dashboardu – utwórz API-Key"

#: includes/Admin/SettingsPage.php:457
msgid "API key"
msgstr "API-Key"

#: includes/Admin/SettingsPage.php:468
msgid "You can find the full key under Settings → API keys in your Deepglot project."
msgstr "Pełny klucz znajdziesz w Ustawieniach → API-Keys w swoim projekcie Deepglot."

#: includes/Admin/SettingsPage.php:472
msgid "Backend URL"
msgstr "Zaplecze URL"

#: includes/Admin/SettingsPage.php:480
msgid "Default: https://deepglot.ai/api – change only for self-hosting."
msgstr "Domyślnie: https://deepglot.ai/api – zmiana tylko dla Self-Hosting."

#: includes/Admin/SettingsPage.php:492
msgid "Configure languages"
msgstr "Skonfiguruj języki"

#: includes/Admin/SettingsPage.php:494
msgid "Specify the original language and the desired translation languages."
msgstr "Określ język oryginału i żądane języki tłumaczenia."

#: includes/Admin/SettingsPage.php:498
msgid "The source language, target languages, and automatic redirect are managed in the Deepglot dashboard and are only displayed here."
msgstr "Język źródłowy, języki docelowe i automatyczne przekierowanie są zarządzane w panelu Deepglot, a tutaj są tylko wyświetlane."

#: includes/Admin/SettingsPage.php:500
msgid "Open project settings"
msgstr "Otwórz ustawienia projektu"

#: includes/Admin/SettingsPage.php:506
msgid "Original language"
msgstr "Język oryginalny"

#: includes/Admin/SettingsPage.php:518
#: includes/Admin/SettingsPage.php:1275
msgid "Target languages"
msgstr "Języki docelowe"

#: includes/Admin/SettingsPage.php:527
msgid "Comma-separated ISO 639-1 codes, such as en, fr, and it"
msgstr "Kody ISO-639-1 oddzielone przecinkami, np. B. en, fr, to"

#: includes/Admin/SettingsPage.php:539
msgid "Enable translation"
msgstr "Włącz tłumaczenie"

#: includes/Admin/SettingsPage.php:541
msgid "Once API key and languages are saved, enable automatic translation here."
msgstr "Po zapisaniu API-Key i języków włącz tutaj automatyczne tłumaczenie."

#: includes/Admin/SettingsPage.php:553
msgid "Activate Deepglot for all frontend requests"
msgstr "Aktywuj Deepglot dla wszystkich żądań frontonu"

#: includes/Admin/SettingsPage.php:558
msgid "Translation is enabled but stalled: the API key is rejected."
msgstr "Tłumaczenie jest włączone, ale stoi w miejscu: API-Key zostało odrzucone."

#. translators: %1$s: source language, %2$s: target languages
#: includes/Admin/SettingsPage.php:566
#, php-format
msgid "Active – pages are translated from %1$s to %2$s at /%3$s/your-page/"
msgstr "Aktywne – strony są tłumaczone z %1$s na %2$s w obszarze /%3$s/ihre-seite/"

#: includes/Admin/SettingsPage.php:595
msgid "Automatically redirect visitors based on browser language (optional)"
msgstr "Automatycznie przekierowuj odwiedzających na podstawie języka przeglądarki (opcjonalnie)"

#: includes/Admin/SettingsPage.php:604
msgid "Hide advanced settings"
msgstr "Ukryj ustawienia zaawansowane"

#: includes/Admin/SettingsPage.php:604
#: includes/Admin/SettingsPage.php:605
msgid "Show advanced settings"
msgstr "Pokaż ustawienia zaawansowane"

#: includes/Admin/SettingsPage.php:609
msgid "Excluded URLs"
msgstr "Wykluczono URL"

#: includes/Admin/SettingsPage.php:611
msgid "One URL or pattern per line."
msgstr "Jeden URL lub wzór w linii."

#: includes/Admin/SettingsPage.php:614
msgid "Routing mode"
msgstr "Tryb routingu"

#: includes/Admin/SettingsPage.php:617
msgid "Path prefix (/en/my-page)"
msgstr "Prefiks ścieżki (/en/meine-seite)"

#: includes/Admin/SettingsPage.php:620
msgid "Subdomains (en.example.com)"
msgstr "Subdomeny (en.example.com)"

#: includes/Admin/SettingsPage.php:623
msgid "Path prefix remains the default. For subdomains, each active target language needs a host."
msgstr "Przedrostek ścieżki pozostaje domyślny. W przypadku subdomen każdy aktywny język docelowy potrzebuje hosta."

#: includes/Admin/SettingsPage.php:626
msgid "Domain mappings"
msgstr "Mapowania domen"

#: includes/Admin/SettingsPage.php:634
msgid "Format: language-code=host, one mapping per line."
msgstr "Format: sprachcode=host, jedno przypisanie w wierszu."

#: includes/Admin/SettingsPage.php:646
msgid "Translate WooCommerce and wp_mail emails"
msgstr "Tłumaczenie e-maili WooCommerce i wp_mail"

#: includes/Admin/SettingsPage.php:659
msgid "Run searches in the visitor’s language"
msgstr "Przeprowadź wyszukiwanie w języku odwiedzającego"

#: includes/Admin/SettingsPage.php:672
msgid "Translate AMP pages"
msgstr "Tłumaczenie stron AMP"

#: includes/Admin/SettingsPage.php:685
msgid "Translate dynamically loaded content (AJAX, infinite scroll, SPA)"
msgstr "Tłumaczenie dynamicznie ładowanej treści (AJAX, nieograniczone przewijanie, SPA)"

#: includes/Admin/SettingsPage.php:689
msgid "Excluded CSS selectors"
msgstr "Wykluczono selektory CSS"

#: includes/Admin/SettingsPage.php:691
msgid "One CSS class, ID or selector per line."
msgstr "Jedna klasa CSS, identyfikator lub selektor na linię."

#: includes/Admin/SettingsPage.php:725
msgid "Language switcher settings"
msgstr "Przełącznik języka"

#: includes/Admin/SettingsPage.php:726
msgid "How and where should the language switcher appear on your website?"
msgstr "Jak i gdzie powinien pojawić się Language-Switcher na Twojej stronie internetowej?"

#: includes/Admin/SettingsPage.php:739
msgid "Automatically add the language switcher to the page footer"
msgstr "Automatycznie wstaw Switcher w stopce strony"

#: includes/Admin/SettingsPage.php:744
#: includes/Admin/SettingsPage.php:1356
msgid "Name"
msgstr "imię"

#: includes/Admin/SettingsPage.php:749
#: includes/Admin/SettingsPage.php:1405
msgid "Activate instance"
msgstr "Aktywuj instancję"

#: includes/Admin/SettingsPage.php:752
#: includes/Admin/SettingsPage.php:1444
msgid "DOM target for automatic placement"
msgstr "Cel DOM do automatycznego umieszczania"

#: includes/Admin/SettingsPage.php:756
msgid "Alternatively: Shortcode [deepglot_switcher] or PHP do_action('deepglot_language_switcher') in your theme."
msgstr "Alternatywnie: Shortcode [deepglot_switcher] lub PHP do_action('deepglot_language_switcher') w swoim motywie."

#: includes/Admin/SettingsPage.php:761
#: includes/Admin/SettingsPage.php:1360
msgid "Presentation"
msgstr "Prezentacja"

#: includes/Admin/SettingsPage.php:764
#: includes/Admin/SettingsPage.php:1362
msgid "Inline list"
msgstr "Lista wbudowana"

#: includes/Admin/SettingsPage.php:767
#: includes/Admin/SettingsPage.php:1363
msgid "Dropdown"
msgstr "Zejdź na dół"

#: includes/Admin/SettingsPage.php:773
#: includes/Admin/SettingsPage.php:1367
msgid "Flag style"
msgstr "Styl flagi"

#: includes/Admin/SettingsPage.php:776
msgid "Rectangular, matte"
msgstr "Prostokątny, matowy"

#: includes/Admin/SettingsPage.php:779
msgid "Rectangular, shiny"
msgstr "Prostokątny, błyszczący"

#: includes/Admin/SettingsPage.php:782
msgid "Circle, matte"
msgstr "Okrąg, matowy"

#: includes/Admin/SettingsPage.php:785
msgid "Circle, shiny"
msgstr "Okrąg, błyszczący"

#: includes/Admin/SettingsPage.php:788
msgid "Without a flag"
msgstr "Bez flagi"

#: includes/Admin/SettingsPage.php:794
#: includes/Admin/SettingsPage.php:937
#: includes/Admin/SettingsPage.php:1375
#: includes/Admin/SettingsPage.php:1428
msgid "Language label"
msgstr "Oznaczenie języka"

#: includes/Admin/SettingsPage.php:797
msgid "Full name (\"English\")"
msgstr "Imię i nazwisko („niemiecki”)"

#: includes/Admin/SettingsPage.php:800
msgid "ISO code (\"EN\")"
msgstr "ISO-Code („DE”)"

#: includes/Admin/SettingsPage.php:806
msgid "Display device"
msgstr "Urządzenie wyświetlające"

#: includes/Admin/SettingsPage.php:809
msgid "Show on all devices"
msgstr "Pokaż na wszystkich urządzeniach"

#: includes/Admin/SettingsPage.php:812
msgid "Desktop only (hide on mobile)"
msgstr "Tylko komputer stacjonarny (ukryj na urządzeniu mobilnym)"

#: includes/Admin/SettingsPage.php:815
msgid "Mobile only (hide on desktop)"
msgstr "Tylko urządzenia mobilne (ukryj na komputerze)"

#: includes/Admin/SettingsPage.php:821
msgid "Mobile breakpoint (px)"
msgstr "Mobilny punkt przerwania (px)"

#: includes/Admin/SettingsPage.php:833
msgid "Default: 768 px. Below this width, a device is treated as mobile."
msgstr "Domyślnie 768 pikseli. Poniżej tej szerokości strona jest uważana za „mobilną”."

#: includes/Admin/SettingsPage.php:838
msgid "Position on the page"
msgstr "Pozycja na stronie"

#: includes/Admin/SettingsPage.php:841
msgid "Inline (at the embedded location)"
msgstr "Inline (w osadzonej lokalizacji)"

#: includes/Admin/SettingsPage.php:844
msgid "Floating: bottom right"
msgstr "Pływające: prawy dolny róg"

#: includes/Admin/SettingsPage.php:847
msgid "Floating: bottom left"
msgstr "Pływające: lewy dolny róg"

#: includes/Admin/SettingsPage.php:850
msgid "Floating: top right"
msgstr "Pływające: w prawym górnym rogu"

#: includes/Admin/SettingsPage.php:853
msgid "Floating: top left"
msgstr "Pływające: u góry po lewej"

#: includes/Admin/SettingsPage.php:857
msgid "Floating pins the switcher to a corner using position: fixed. Combined with automatic placement, this matches the default Weglot behavior."
msgstr "„Pływający” przypina Switcher do rogu z position:fixed i przewija wraz z nim. W połączeniu z funkcją Auto-Inject = domyślne zachowanie Weglot."

#: includes/Admin/SettingsPage.php:872
msgid "Show language label"
msgstr "Oznaczenie widoczne"

#: includes/Admin/SettingsPage.php:879
msgid "Order of languages"
msgstr "Kolejność języków"

#: includes/Admin/SettingsPage.php:898
msgid "Rearrange using drag & drop. Works in both Shortcode and auto-inject."
msgstr "Zmień kolejność za pomocą metody „przeciągnij i upuść”. Działa zarówno w Shortcode, jak i w trybie automatycznego wstrzykiwania."

#: includes/Admin/SettingsPage.php:902
msgid "Custom flags by language (optional)"
msgstr "Własne flagi dla każdego języka (opcjonalnie)"

#: includes/Admin/SettingsPage.php:923
msgid "🇺🇸 or https://example.com/flag.svg"
msgstr ""

#: includes/Admin/SettingsPage.php:932
msgid "Leave blank to use the default flag. Enter an emoji (for example, 🇺🇸 for English in the US) or an SVG/PNG URL. CSS special characters are removed automatically."
msgstr "Pozostaw puste = flaga domyślna. Emoji (np. 🇺🇸 dla rynku EN → USA) lub URL do SVG/PNG. CSS znaki specjalne są automatycznie usuwane."

#: includes/Admin/SettingsPage.php:947
msgid "Custom CSS for the switcher"
msgstr "Posiadaj CSS dla Switcher"

#: includes/Admin/SettingsPage.php:955
msgid "Inserted in a <style> tag immediately before the switcher. The \"<\" character is removed to prevent injection of a script tag."
msgstr "Wstawiony bezpośrednio przed Switcher jako znacznik <style>. Znak „<” jest automatycznie usuwany, tak że nie można wstawić znacznika skryptu."

#: includes/Admin/SettingsPage.php:967
msgid "More Switcher instances"
msgstr "Więcej instancji Switcher"

#: includes/Admin/SettingsPage.php:969
msgid "Create independent switchers for shortcodes, blocks, widgets, or automatic placement. The existing global switcher remains available as the \"default\" instance."
msgstr "Utwórz niezależny Switcher dla Shortcode, bloku, widżetu lub automatycznego umieszczania. Istniejąca globalna Switcher pozostaje instancją „domyślną”."

#: includes/Admin/SettingsPage.php:971
msgid "Switcher templates"
msgstr "Switcher szablony"

#: includes/Admin/SettingsPage.php:999
msgid "New Switcher"
msgstr "Nowy Switcher"

#: includes/Admin/SettingsPage.php:1010
msgid "Save settings"
msgstr "Zapisz ustawienia"

#. translators: %s: dashboard url
#: includes/Admin/SettingsPage.php:1021
#, php-format
msgid "Help & Documentation: %s"
msgstr "Pomoc i dokumentacja: %s"

#: includes/Admin/SettingsPage.php:1155
msgid "Not started yet"
msgstr "Jeszcze nie rozpoczęte"

#: includes/Admin/SettingsPage.php:1156
msgid "In queue"
msgstr "W kolejce"

#: includes/Admin/SettingsPage.php:1157
msgid "Running"
msgstr "Biegnie"

#: includes/Admin/SettingsPage.php:1158
msgid "Translations are being cached"
msgstr "Tłumaczenia są ocieplone"

#: includes/Admin/SettingsPage.php:1159
msgid "Waiting due to API rate limit"
msgstr "Oczekiwanie ze względu na limit szybkości API"

#: includes/Admin/SettingsPage.php:1160
msgid "Paused"
msgstr "Wstrzymano"

#: includes/Admin/SettingsPage.php:1161
msgid "Paused: word quota reached"
msgstr "Wstrzymano: osiągnięto limit słów"

#: includes/Admin/SettingsPage.php:1162
msgid "Paused: API key invalid"
msgstr "Wstrzymano: API-Key nieprawidłowy"

#: includes/Admin/SettingsPage.php:1163
msgid "Completed"
msgstr "Ukończono"

#: includes/Admin/SettingsPage.php:1164
msgid "Completed with errors"
msgstr "Zakończone z błędami"

#: includes/Admin/SettingsPage.php:1165
msgid "Aborted"
msgstr "Przerwano"

#: includes/Admin/SettingsPage.php:1186
msgid "URL synchronization"
msgstr "Synchronizacja URL"

#: includes/Admin/SettingsPage.php:1187
msgid "Opens selected target language pages in a controlled manner in the background. Missing segments end up in the limited translation queue; Bots and an unlimited duration crawl are not used."
msgstr "Otwiera wybrane strony w języku docelowym w kontrolowany sposób w tle. Brakujące segmenty trafiają do ograniczonej kolejki tłumaczeń; Boty i indeksowanie o nieograniczonym czasie trwania nie są używane."

#: includes/Admin/SettingsPage.php:1197
msgid "Status:"
msgstr "Stan:"

#: includes/Admin/SettingsPage.php:1206
msgid "URLs total"
msgstr "Łącznie URL"

#: includes/Admin/SettingsPage.php:1207
msgid "Queue processed"
msgstr "Kolejka przetworzona"

#: includes/Admin/SettingsPage.php:1208
msgid "Being cached"
msgstr "Są rozgrzane"

#: includes/Admin/SettingsPage.php:1209
msgid "Failed"
msgstr "Nie udało się"

#: includes/Admin/SettingsPage.php:1211
msgid "\"Processed\" confirms completion in the Deepglot queue at the WordPress origin. Afterward, check the public target-language page without sync parameters and manually clear any unsupported full-page cache."
msgstr "„Przetworzone” potwierdza kolejkę Deepglot na początku WordPress. Po zakończeniu sprawdź stronę publicznego języka docelowego bez parametrów synchronizacji i ręcznie wyczyść nieobsługiwaną pamięć podręczną całej strony."

#: includes/Admin/SettingsPage.php:1216
msgid "Failed URLs"
msgstr "Nieudane URLs"

#: includes/Admin/SettingsPage.php:1236
msgid "Retry failed URLs"
msgstr "Ponowna próba nie powiodła się URLs"

#: includes/Admin/SettingsPage.php:1242
msgid "URL preview"
msgstr "Podgląd URL"

#. translators: %d: number of target-language URLs in the preview.
#: includes/Admin/SettingsPage.php:1247
#, php-format
msgid "%d target pages will be synchronized."
msgstr "%d Strony docelowe są zsynchronizowane."

#: includes/Admin/SettingsPage.php:1267
msgid "Confirm preview and start synchronization"
msgstr "Potwierdź podgląd i rozpocznij synchronizację"

#: includes/Admin/SettingsPage.php:1286
msgid "Maximum number of target pages"
msgstr "Maksymalna liczba stron docelowych"

#: includes/Admin/SettingsPage.php:1288
msgid "Start with a small sample on large sites. Each run requests at most two pages; synchronization waits when the translation queue is full."
msgstr "W przypadku dużych witryn zacznij od małej próbki. W jednym przebiegu dotykane są maksymalnie dwie strony; Jeśli kolejka tłumaczeń jest pełna, synchronizacja czeka automatycznie."

#: includes/Admin/SettingsPage.php:1292
msgid "Load the next URL batch as a preview"
msgstr "Załaduj następną partię URL jako podgląd"

#: includes/Admin/SettingsPage.php:1293
msgid "Create URL preview"
msgstr "Utwórz podgląd URL"

#: includes/Admin/SettingsPage.php:1299
msgid "Update status"
msgstr "Aktualizuj stan"

#: includes/Admin/SettingsPage.php:1304
msgid "Continue"
msgstr "Kontynuuj"

#: includes/Admin/SettingsPage.php:1304
msgid "Pause"
msgstr "Pauza"

#: includes/Admin/SettingsPage.php:1313
msgid "Really cancel synchronization? Translations that have already been saved are retained."
msgstr "Na pewno anulować synchronizację? Tłumaczenia, które zostały już zapisane, zostaną zachowane."

#: includes/Admin/SettingsPage.php:1314
msgid "Cancel"
msgstr "Anuluj"

#: includes/Admin/SettingsPage.php:1343
msgid "Remove instance"
msgstr "Usuń instancję"

