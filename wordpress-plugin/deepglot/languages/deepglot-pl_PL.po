msgid "Backend-URL"
msgstr "Zaplecze URL"

#: includes/Admin/SettingsPage.php:358
msgid "Standard: https://deepglot.ai/api – nur ändern bei Self-Hosting."
msgstr "Domyślnie: https://deepglot.ai/api – zmiana tylko dla Self-Hosting."

