msgstr "Čárkami oddělené kódy ISO-639-1, např. B. en, fr, it"

#: includes/Admin/SettingsPage.php:526
msgid "Übersetzung aktivieren"
msgstr "Povolit překlad"

#: includes/Admin/SettingsPage.php:528
msgid "Sobald API-Key und Sprachen gespeichert sind, aktiviere die automatische Übersetzung hier."
msgstr "Po uložení API-Key a jazyků zde povolte automatický překlad."

#: includes/Admin/SettingsPage.php:540
msgid "Deepglot für alle Frontend-Anfragen aktiv schalten"
msgstr "Aktivujte Deepglot pro všechny požadavky frontendu"

#: includes/Admin/SettingsPage.php:545
msgid "Übersetzung ist eingeschaltet, steht aber still: Der API-Key wird abgelehnt."
msgstr "Překlad je zapnutý, ale stojí: API-Key je zamítnuto."

