msgid "Backend-URL"
msgstr "Servidor URL"

#: includes/Admin/SettingsPage.php:477
msgid "Standard: https://deepglot.ai/api – nur ändern bei Self-Hosting."
msgstr "Valor predeterminado: https://deepglot.ai/api – solo cambia para Self-Hosting."

