msgstr "Pomocník a dokumentácia: %s"

#: includes/Admin/SettingsPage.php:1132
msgid "Noch nicht gestartet"
msgstr "Ešte nezačaté"

#: includes/Admin/SettingsPage.php:1133
msgid "In Warteschlange"
msgstr "V rade"

#: includes/Admin/SettingsPage.php:1134
msgid "Läuft"
msgstr "Beží"

#: includes/Admin/SettingsPage.php:1135
msgid "Übersetzungen werden aufgewärmt"
msgstr "Preklady sa zahrievajú"

#: includes/Admin/SettingsPage.php:1136
