msgstr "Pozastavené"

#: includes/Admin/SettingsPage.php:1138
msgid "Pausiert: Wortkontingent erreicht"
msgstr "Pozastavené: dosiahla sa kvóta slov"

#: includes/Admin/SettingsPage.php:1139
