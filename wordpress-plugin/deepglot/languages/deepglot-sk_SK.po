msgstr "https://deepglot.ai"

#. Description of the plugin
#: deepglot.php
msgid "Translates WordPress content with Deepglot and a compatible translation API."
msgstr "Prekladá obsah WordPress pomocou Deepglot a kompatibilného prekladového API."

#. Author of the plugin
#: deepglot.php
msgid "Andreas Ostheimer"
msgstr "Andreas Osheimer"

#. Author URI of the plugin
#: deepglot.php
msgid "https://www.ostheimer.at"
msgstr "https://www.ostheimer.at"

