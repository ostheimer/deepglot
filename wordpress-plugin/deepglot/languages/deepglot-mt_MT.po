msgstr "https://deepglot.ai"

#. Description of the plugin
#: deepglot.php
msgid "Translates WordPress content with Deepglot and a compatible translation API."
msgstr "Tittraduċi kontenut WordPress billi tuża Deepglot u API ta' traduzzjoni kompatibbli."

