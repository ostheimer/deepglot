#: includes/Admin/SettingsPage.php:781
#: includes/Admin/SettingsPage.php:1352
msgid "Sprachbezeichnung"
msgstr "Γλωσσικός προσδιορισμός"

#: includes/Admin/SettingsPage.php:784
msgid "Volle Bezeichnung („Deutsch\")"
msgstr "Πλήρες όνομα («Γερμανικά»)"

#: includes/Admin/SettingsPage.php:787
msgid "ISO-Code („DE\")"
msgstr "ISO-Code (\"DE\")"

#: includes/Admin/SettingsPage.php:793
msgid "Anzeigegerät"
msgstr "Συσκευή προβολής"

#: includes/Admin/SettingsPage.php:796
msgid "Auf allen Geräten zeigen"
msgstr "Εμφάνιση σε όλες τις συσκευές"

#: includes/Admin/SettingsPage.php:799
msgid "Nur Desktop (auf Mobile ausblenden)"
msgstr "Μόνο για επιτραπέζιους υπολογιστές (απόκρυψη σε κινητό)"

#: includes/Admin/SettingsPage.php:802
msgid "Nur Mobile (auf Desktop ausblenden)"
msgstr "Μόνο για κινητά (απόκρυψη στον υπολογιστή)"

#: includes/Admin/SettingsPage.php:808
msgid "Mobile-Breakpoint (px)"
msgstr "Σημείο διακοπής για κινητά (px)"

#: includes/Admin/SettingsPage.php:820
msgid "Standard 768 px. Unter dieser Breite gilt eine Seite als „Mobile\"."
msgstr "Προεπιλογή 768 px. Κάτω από αυτό το πλάτος, μια σελίδα θεωρείται \"κινητή\"."

#: includes/Admin/SettingsPage.php:825
msgid "Position auf der Seite"
msgstr "Θέση στη σελίδα"

#: includes/Admin/SettingsPage.php:828
msgid "Inline (an der eingebetteten Stelle)"
msgstr "Inline (στην ενσωματωμένη τοποθεσία)"

#: includes/Admin/SettingsPage.php:831
msgid "Floating: rechts unten"
msgstr "Πλωτό: κάτω δεξιά"

#: includes/Admin/SettingsPage.php:834
msgid "Floating: links unten"
msgstr "Πλωτό: κάτω αριστερά"

#: includes/Admin/SettingsPage.php:837
msgid "Floating: rechts oben"
msgstr "Πλωτό: πάνω δεξιά"

#: includes/Admin/SettingsPage.php:840
msgid "Floating: links oben"
msgstr "Πλωτό: πάνω αριστερά"

#: includes/Admin/SettingsPage.php:844
msgid "„Floating\" pinnt den Switcher mit position:fixed an die Ecke und scrollt mit. Kombiniert mit Auto-Inject = Weglot-Default-Verhalten."
msgstr "Το \"Floating\" καρφιτσώνει το Switcher στη γωνία με το position:fixed και κάνει κύλιση μαζί του. Σε συνδυασμό με Auto-Inject = Weglot προεπιλεγμένη συμπεριφορά."

#: includes/Admin/SettingsPage.php:859
msgid "Bezeichnung sichtbar"
msgstr "Ο προσδιορισμός είναι ορατός"

#: includes/Admin/SettingsPage.php:866
msgid "Reihenfolge der Sprachen"
msgstr "Σειρά γλωσσών"

#: includes/Admin/SettingsPage.php:885
msgid "Per Drag-&-Drop neu anordnen. Greift sowohl im Shortcode als auch beim Auto-Inject."
msgstr "Αναδιάταξη χρησιμοποιώντας μεταφορά και απόθεση. Λειτουργεί τόσο στο Shortcode όσο και στην αυτόματη έγχυση."

#: includes/Admin/SettingsPage.php:889
msgid "Eigene Flaggen pro Sprache (optional)"
msgstr "Δικές σημαίες ανά γλώσσα (προαιρετικό)"

#: includes/Admin/SettingsPage.php:919
msgid "Leer lassen = Default-Flagge. Emoji (z. B. 🇺🇸 für EN→US-Markt) oder URL zu SVG/PNG. CSS-Sonderzeichen werden automatisch entfernt."
msgstr "Αφήστε κενό = προεπιλεγμένη σημαία. Οι ειδικοί χαρακτήρες Emoji (π.χ. 🇺🇸 για την αγορά EN→ΗΠΑ) ή URL έως SVG/PNG. CSS καταργούνται αυτόματα."

#: includes/Admin/SettingsPage.php:924
msgid "Eigenes CSS für den Switcher"
msgstr "Κάτοχος CSS για το Switcher"

#: includes/Admin/SettingsPage.php:932
msgid "Wird unmittelbar vor dem Switcher als <style>-Tag eingefügt. „<\" wird automatisch entfernt, damit kein Script-Tag eingeschleust werden kann."
msgstr "Εισάγεται αμέσως πριν από την Switcher ως ετικέτα <style>. Το \"<\" αφαιρείται αυτόματα, ώστε να μην μπορεί να εισαχθεί καμία ετικέτα σεναρίου."

#: includes/Admin/SettingsPage.php:944
msgid "Weitere Switcher-Instanzen"
msgstr "Περισσότερες περιπτώσεις Switcher"

#: includes/Admin/SettingsPage.php:946
msgid "Erstelle unabhängige Switcher für Shortcode, Block, Widget oder automatische Platzierung. Der bestehende globale Switcher bleibt als Instanz „default\" erhalten."
msgstr "Δημιουργήστε ανεξάρτητο Switcher για Shortcode, μπλοκ, γραφικό στοιχείο ή αυτόματη τοποθέτηση. Η υπάρχουσα καθολική Switcher παραμένει ως η \"προεπιλεγμένη\" παρουσία."

#: includes/Admin/SettingsPage.php:948
msgid "Switcher-Vorlagen"
msgstr "Switcher πρότυπα"

#: includes/Admin/SettingsPage.php:976
msgid "Neuer Switcher"
msgstr "Νέο Switcher"

#: includes/Admin/SettingsPage.php:987
msgid "Einstellungen speichern"
msgstr "Αποθήκευση ρυθμίσεων"

#. translators: %s: dashboard url
#: includes/Admin/SettingsPage.php:998
#, php-format
msgid "Hilfe & Dokumentation: %s"
msgstr "Βοήθεια και τεκμηρίωση: %s"

#: includes/Admin/SettingsPage.php:1132
msgid "Noch nicht gestartet"
msgstr "Δεν έχει ξεκινήσει ακόμα"

#: includes/Admin/SettingsPage.php:1133
msgid "In Warteschlange"
msgstr "Στην ουρά"

#: includes/Admin/SettingsPage.php:1134
msgid "Läuft"
msgstr "Τρέχει"

#: includes/Admin/SettingsPage.php:1135
msgid "Übersetzungen werden aufgewärmt"
msgstr "Οι μεταφράσεις ζεσταίνονται"

