msgstr "https://deepglot.ai"

#. Description of the plugin
#: deepglot.php
msgid "Translates WordPress content with Deepglot and a compatible translation API."
msgstr "Tulko WordPress saturu, izmantojot Deepglot un saderīgu tulkošanas API."

