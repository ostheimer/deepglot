msgstr ""

#: includes/Admin/SettingsPage.php:932
msgid "Leave blank to use the default flag. Enter an emoji (for example, 🇺🇸 for English in the US) or an SVG/PNG URL. CSS special characters are removed automatically."
msgstr "Lad være tomt = standardflag. Emoji (f.eks. 🇺🇸 for EN→amerikansk marked) eller URL til SVG/PNG. CSS specialtegn fjernes automatisk."

#: includes/Admin/SettingsPage.php:947
msgid "Custom CSS for the switcher"
msgstr "Eje CSS til Switcher"

#: includes/Admin/SettingsPage.php:955
msgid "Inserted in a <style> tag immediately before the switcher. The \"<\" character is removed to prevent injection of a script tag."
msgstr "Indsat umiddelbart før Switcher som <style> tag. \"<\" fjernes automatisk, så der ikke kan indsættes et script-tag."

