msgstr "https://deepglot.ai"

#. Description of the plugin
#: deepglot.php
msgid "Translates WordPress content with Deepglot and a compatible translation API."
msgstr "Vertaalt WordPress-inhoud met behulp van Deepglot en een compatibele vertaal-API."

#. Author of the plugin
#: deepglot.php
msgid "Andreas Ostheimer"
msgstr "Andreas Ostheimer"

#. Author URI of the plugin
