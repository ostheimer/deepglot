msgid "Backend-URL"
msgstr "Zaledje URL"

#: includes/Admin/SettingsPage.php:358
msgid "Standard: https://deepglot.ai/api – nur ändern bei Self-Hosting."
msgstr "Privzeto: https://deepglot.ai/api – sprememba samo za Self-Hosting."

