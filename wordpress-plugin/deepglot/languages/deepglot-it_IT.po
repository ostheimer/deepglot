#: includes/Admin/SettingsPage.php:867
msgid "Eigene Flaggen pro Sprache (optional)"
msgstr "Proprie bandiere per lingua (opzionale)"

#: includes/Admin/SettingsPage.php:897
msgid "Leer lassen = Default-Flagge. Emoji (z. B. 🇺🇸 für EN→US-Markt) oder URL zu SVG/PNG. CSS-Sonderzeichen werden automatisch entfernt."
msgstr "Lascia vuoto = flag predefinito. Le emoji (ad es. 🇺🇸 per il mercato EN→US) o i caratteri speciali da URL a SVG/PNG. CSS vengono rimossi automaticamente."

#: includes/Admin/SettingsPage.php:902
msgid "Eigenes CSS für den Switcher"
msgstr "Possiedi CSS per Switcher"

#: includes/Admin/SettingsPage.php:910
