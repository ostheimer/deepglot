msgstr "На опашка"

#: includes/Admin/SettingsPage.php:1134
msgid "Läuft"
msgstr "Бяга"

#: includes/Admin/SettingsPage.php:1135
msgid "Übersetzungen werden aufgewärmt"
msgstr "Преводите се подгряват"

#: includes/Admin/SettingsPage.php:1136
msgid "Wartet wegen API-Ratenlimit"
msgstr "Изчакване поради ограничение на скоростта на API"

#: includes/Admin/SettingsPage.php:1137
msgid "Pausiert"
msgstr "На пауза"

#: includes/Admin/SettingsPage.php:1138
