msgstr "На пауза: квотата за думи е достигната"

#: includes/Admin/SettingsPage.php:1139
msgid "Pausiert: API-Key ungültig"
msgstr "На пауза: API-Key невалиден"

#: includes/Admin/SettingsPage.php:1140
msgid "Abgeschlossen"
msgstr "Завършено"

#: includes/Admin/SettingsPage.php:1141
msgid "Mit Fehlern abgeschlossen"
msgstr "Завършено с грешки"

#: includes/Admin/SettingsPage.php:1142
msgid "Abgebrochen"
msgstr "Прекратено"

#: includes/Admin/SettingsPage.php:1163
msgid "URL-Synchronisierung"
msgstr "URL синхронизация"

#: includes/Admin/SettingsPage.php:1164
msgid "Ruft ausgewählte Zielsprachseiten kontrolliert im Hintergrund auf. Fehlende Segmente landen in der begrenzten Übersetzungs-Warteschlange; Bots und ein unbegrenzter Dauer-Crawl werden nicht verwendet."
msgstr "Отваря избраните целеви езикови страници по контролиран начин във фонов режим. Липсващите сегменти се озовават в ограничената опашка за превод; Не се използват ботове и обхождане с неограничена продължителност."

#: includes/Admin/SettingsPage.php:1174
msgid "Status:"
msgstr "Статус:"

#: includes/Admin/SettingsPage.php:1183
msgid "URLs gesamt"
