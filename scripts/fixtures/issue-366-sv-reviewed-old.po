msgstr "Pausad: ordkvoten har nåtts"

#: includes/Admin/SettingsPage.php:1139
msgid "Pausiert: API-Key ungültig"
msgstr "Pausad: API-nyckeln är ogiltig"

#: includes/Admin/SettingsPage.php:1140
msgid "Abgeschlossen"
msgstr "Slutförd"

#: includes/Admin/SettingsPage.php:1141
msgid "Mit Fehlern abgeschlossen"
msgstr "Slutförd med fel"

#: includes/Admin/SettingsPage.php:1142
msgid "Abgebrochen"
msgstr "Avbruten"

#: includes/Admin/SettingsPage.php:1163
msgid "URL-Synchronisierung"
msgstr "URL-synkronisering"

#: includes/Admin/SettingsPage.php:1164
msgid "Ruft ausgewählte Zielsprachseiten kontrolliert im Hintergrund auf. Fehlende Segmente landen in der begrenzten Übersetzungs-Warteschlange; Bots und ein unbegrenzter Dauer-Crawl werden nicht verwendet."
msgstr "Hämtar valda sidor på målspråken i bakgrunden, med begränsningar. Saknade textsegment läggs i den begränsade översättningskön. Inga robotar eller obegränsade genomsökningar används."

#: includes/Admin/SettingsPage.php:1174
msgid "Status:"
msgstr "Status:"

#: includes/Admin/SettingsPage.php:1183
msgid "URLs gesamt"
msgstr "Totalt antal URL:er"

#: includes/Admin/SettingsPage.php:1184
msgid "Warteschlange abgearbeitet"
msgstr "Kö behandlad"

#: includes/Admin/SettingsPage.php:1185
msgid "Werden aufgewärmt"
msgstr "Förbereds"

#: includes/Admin/SettingsPage.php:1186
msgid "Fehlgeschlagen"
msgstr "Misslyckades"

#: includes/Admin/SettingsPage.php:1188
msgid "„Abgearbeitet“ bestätigt die Deepglot-Warteschlange am WordPress-Ursprung. Prüfe nach Abschluss die öffentliche Zielsprachseite ohne Sync-Parameter und leere einen nicht unterstützten Full-Page-Cache manuell."
msgstr "”Kö behandlad” bekräftar att Deepglots kö på WordPress-servern har behandlats. När körningen är klar kontrollerar du den offentliga sidan på målspråket utan synkroniseringsparametrar. Töm manuellt en cache för hela sidor om den inte stöds."

#: includes/Admin/SettingsPage.php:1193
msgid "Fehlgeschlagene URLs"
msgstr "URL:er som misslyckades"

#: includes/Admin/SettingsPage.php:1213
msgid "Fehlgeschlagene URLs erneut versuchen"
msgstr "Försök igen med URL:er som misslyckades"

#: includes/Admin/SettingsPage.php:1219
