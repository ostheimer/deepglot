{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "crons": [
    {
      "path": "/api/webhooks/process",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/activity-digest",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/page-view-retention",
      "schedule": "17 3 * * *"
    }
  ]
}
